# Optional MongoDB (leave blank for local JSON mode)
MONGODB_URI=

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Server
PORT=3000
NODE_ENV=development

# Optional Lucy AI Gemini fallback
GEMINI_API_KEY=

# Optional report notifications (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional one-time admin bootstrap (leave empty to disable)
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASS=
